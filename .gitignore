# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# cloudflare / opennext
# .open-next is the build output - the equivalent of .next for this adapter.
/.open-next/
# wrangler's local state (dev registry, sqlite, cached types). It appeared as an
# untracked directory the first time `opennextjs-cloudflare preview` ran.
/.wrangler/
# Local Worker variables. The committed template is .dev.vars.example; this file is
# ignored because it is where a real secret would eventually be put.
.dev.vars
.dev.vars.*
!.dev.vars.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
